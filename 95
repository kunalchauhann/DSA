package AG;

import java.util.Scanner;

public class Q88 {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        String str = sc.nextLine();

        for (int i = 0; i < str.length(); i++) {

            char ch = str.charAt(i);
            boolean app = false;

            // Check whether character already appeared
            for (int j = 0; j < i; j++) {
                if (str.charAt(j) == ch) {
                    app = true;
                    break;
                }
            }

            // If character is appearing for first time
            if (!app) {

                int count = 0;

                // Count frequency
                for (int j = 0; j < str.length(); j++) {
                    if (str.charAt(j) == ch) {
                        count++;
                    }
                }

                System.out.println(ch + " occurs " + count + " times");
            }
        }
    }
}
