package Arraylist;

import java.util.Scanner;

public class Q3 {
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter the size of array: ");
        int n = sc.nextInt();
        System.out.println("Enter the integer you want: ");
        int a = sc.nextInt();
        int []arr = new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int result =-1;
        for(int i=0;i<n;i++){
            if(arr[i]==a){
                result =i;
            }
        }
        System.out.println(result);
    }
}
