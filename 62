package AG;
import java.util.Arrays;
public class Q62_rotate_right_by2 {
    public static void main(String[]args){
        int[]arr = {1,2,3,4,5};
        int k =2;
        k=k%arr.length;
        for(int j=1;j<=k;j++){
            int temp =arr[0];
            for(int i=1;i<arr.length;i++){
                arr[i-1]=arr[i];
            }
            arr[arr.length-1]=temp;
        }
        System.out.println(Arrays.toString(arr));
    }
}
