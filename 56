package AG;
import java.util.Scanner;

public class Q56_search {
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int [] arr={5,7,9,12};
        System.out.println("Enter the number: ");
        int n=sc.nextInt();
        for(int i=0;i<n;i++){
            if(arr[i]==n){
                System.out.println(i);
                break;
            }
        }
    }
}
