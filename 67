package AG;
import java.util.Scanner;
public class Q67_freq_array2 {
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int []arr = new int[10];
        for(int i=0;i<10;i++){
            arr[i]=sc.nextInt();
        }
        boolean[] visited= new boolean[10];
        for(int i=0;i<10;i++){
            if(visited[i]){
                continue;
            }
            int count=1;
            for(int j=i+1;j<10;j++){
                if(arr[i]==arr[j]){
                    count++;
                    visited[j]=true;
                }
            }
            System.out.println(arr[i]+" = "+count);
        }
    }
}
