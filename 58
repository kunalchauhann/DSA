package AG;
import java.util.Arrays;
public class Q58_swap_EXOR {
    public static void main(String[]args){
        int [] arr ={1,2,3,4,5,6};
        int i=0;
        int j=arr.length-1;
        while(i<j){
            arr[i]=arr[i]^arr[j];
            arr[j]=arr[i]^arr[j];
            arr[i]=arr[i]^arr[j];
            i++;
            j--;
        }
        System.out.println(Arrays.toString(arr));
    }
}
