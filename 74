package AG;
import java.util.Scanner;
public class Q29 {
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int sum=0;
        for(int i=1;i<=a;i++){
            int digit=a%10;
            sum=sum+digit;
            a/=10;
        }
        System.out.println(sum);
    }
}
