import java.util.Scanner;
public class ar14 {
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int n=sc.nextInt();
        int [] arr = new int[n];
        for(int i=0;i<n;i++){
            arr[i]= sc.nextInt();
        }
        int k =1;
        for(int i=0;i<n;i++){
            k = k*arr[i];
        }
        System.out.println(k);
    }
}
