package AG;
import java.util.Scanner;
public class Q7 {
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter the value of N: ");
        int n =sc.nextInt();
        int s=0;
        for(int i=1;i<=n;i++){
                s=s+(i*i);

        }
        System.out.println(s);
    }
