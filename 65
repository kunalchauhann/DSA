package AG;
import java.util.*;
public class Q65_moving_0 {
    public static void main(){
        int[]  arr ={0 ,2 ,0 ,4 ,5 };
        int j = 0 ;
        for(int i = 0 ; i < arr.length ; i++){
            if(arr[i]!=0){
                int temp = arr[i];
                arr[i]=arr[j];
                arr[j]=temp;
                j++;
            }
        }
        System.out.print(Arrays.toString(arr));
    }
}
